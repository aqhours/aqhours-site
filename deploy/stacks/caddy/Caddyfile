{
	email aqhours@gmail.com
}

aqhours.cn, www.aqhours.cn {
	@deploy_hooks {
		method POST
		path /hooks/aqhours-site /hooks/eternal-card
	}

	handle @deploy_hooks {
		reverse_proxy 172.18.0.1:9000
	}

	handle {
		reverse_proxy homepage:80
	}
}

archivebox.aqhours.cn {
	reverse_proxy archivebox-app:8000
}

http://headscale.aqhours.cn {
	handle /generate_204 {
		respond 204
	}

	handle * {
		redir https://{host}{uri}
	}
}

headscale.aqhours.cn {
	reverse_proxy headscale-app:8080 {
		header_up True-Client-IP {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

eternalcard.aqhours.cn {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	reverse_proxy eternal-card-app:3000
}

analytics.aqhours.cn {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy eternal-card-analytics:3000
}
