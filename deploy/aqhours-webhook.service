[Unit]
Description=aqhours GitHub webhook receiver
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=aqhours-deploy
Group=aqhours-deploy
SupplementaryGroups=docker
Environment=HOME=/var/lib/aqhours-deploy
EnvironmentFile=/etc/aqhours-webhook.env
Environment=DOCKER_CONFIG=/var/lib/aqhours-webhook/docker
StateDirectory=aqhours-webhook
RuntimeDirectory=aqhours-webhook
ExecStartPre=/bin/sh -c 'test -n "$AQHOURS_WEBHOOK_SECRET" && test -n "$AQHOURS_WEBHOOK_IP"'
ExecStart=/usr/bin/webhook -ip ${AQHOURS_WEBHOOK_IP} -port 9000 -hooks /etc/aqhours-webhook/hooks.json.tmpl -template -http-methods POST -verbose
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/apps/homepage /opt/apps/eternal-card /run/aqhours-webhook

[Install]
WantedBy=multi-user.target
